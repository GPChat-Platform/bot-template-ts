# Clé API du bot (console développeur GPChat → Identifiants, ou @gpchat_forge → /newbot puis /token)
GPCHAT_API_KEY=gpk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# polling (défaut) : le bot interroge GPChat, aucun serveur public. Activez-le avec « /setmode polling » dans @gpchat_forge.
# webhook : GPChat appelle votre serveur HTTPS (voir GPCHAT_WEBHOOK_SECRET et PORT).
GPCHAT_MODE=polling

# Mode webhook uniquement : secret de signature (console → Webhooks). Plusieurs valeurs séparées par des virgules
# pendant une rotation de secret.
GPCHAT_WEBHOOK_SECRET=
PORT=8080

# Persistance (préférences des utilisateurs). Vide = mémoire seulement.
DATA_DIR=./data

# userId des administrateurs (commande /stats…), séparés par des virgules. /whoami affiche le vôtre.
ADMIN_IDS=

DEFAULT_LANG=fr
LOG_LEVEL=info

# Mode polling : conversations traitées en parallèle (l'ordre reste garanti dans chaque conversation)
CONCURRENCY=16

# Serveur d'exploitation (/healthz /readyz /metrics) — interne seulement
OPS_PORT=9100
OPS_HOST=127.0.0.1
